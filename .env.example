# Copy this file to .env and fill in what you need. .env is git-ignored.

# 1 = deterministic offline mode, no API calls, no cost. 0 = call a real model.
MOCK_LLM=1

# Only needed when MOCK_LLM=0.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# Where the synthetic Northwind database lives (created by `make data`).
NORTHWIND_DB=data/northwind.db

# Append-only audit log (hash-chained JSONL).
AUDIT_LOG=logs/audit.jsonl

# Backend port for the FastAPI server.
API_PORT=8000
